{
    "name": "mui-rhf-library",
    "version": "4.1.0",
    "homepage": "https://mui-rhf-library.dashty.dev/",
    "description": "A set of configured Material UI form inputs configured with React Hook Form.",
    "author": "dashty94",
    "license": "MIT",
    "keywords": [
        "mui",
        "react",
        "form",
        "yup",
        "react-hook-form",
        "material-ui"
    ],
    "scripts": {
        "build": "pnpm install --dir website --ignore-workspace && pnpm -C website build",
        "rollup": "rm -rf dist && rollup -c",
        "prepublishOnly": "pnpm type-check && pnpm test && pnpm rollup",
        "test": "vitest run",
        "test:watch": "vitest",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "chromatic": "chromatic --exit-zero-on-changes",
        "type-check": "tsc --noEmit",
        "website:dev": "pnpm -C website dev",
        "website:build": "pnpm -C website build",
        "website:preview": "pnpm -C website preview"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@changesets/cli": "^3.0.3",
        "@chromatic-com/storybook": "^5.6.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@hookform/resolvers": "^6.0.0",
        "@mui/material": "^9.5.0",
        "@mui/system": "^9.5.0",
        "@mui/x-date-pickers": "^9.16.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "@rollup/plugin-typescript": "^12.3.1",
        "@storybook/addon-docs": "^10.6.3",
        "@storybook/addon-links": "^10.6.3",
        "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
        "@storybook/react-webpack5": "^10.6.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "chromatic": "^18.13.3",
        "jsdom": "^30.1.3",
        "moment": "^2.31.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "rollup": "^4.65.0",
        "rollup-plugin-dts": "^6.5.1",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "storybook": "10.6.3",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "webpack": "^5.112.2",
        "yup": "^1.7.1"
    },
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "files": [
        "dist/cjs",
        "dist/esm/index.js",
        "dist/esm/index.js.map",
        "dist/index.d.ts"
    ],
    "types": "dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "https://github.com/dashty94/mui-rhf-library"
    },
    "peerDependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^9.0.0",
        "@mui/system": "^9.0.0",
        "@mui/x-date-pickers": "^9.0.0",
        "react": "^19.0.0",
        "react-hook-form": "^7.74.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.11 || ^24 || >=26",
            "onFail": "warn"
        }
    },
    "packageManager": "pnpm@11.28.4"
}